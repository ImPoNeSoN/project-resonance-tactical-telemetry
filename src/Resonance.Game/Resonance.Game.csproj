<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Resonance.Game</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Resonance.Sim\Resonance.Sim.csproj" />
  </ItemGroup>
  <!-- EditorPlugin is not in the player assemblies. Export configurations drop the editor addon. -->
  <ItemGroup Condition="'$(Configuration)' == 'ExportRelease' Or '$(Configuration)' == 'ExportDebug'">
    <Compile Remove="addons/**/*.cs" />
  </ItemGroup>
</Project>
